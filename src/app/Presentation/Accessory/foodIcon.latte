{varType string $icon}
{var $label = [
    'price' => 'Cena',
    'calories' => 'Energie',
    'protein' => 'Bílkoviny',
    'fat' => 'Tuky',
    'carb' => 'Sacharidy',
    'fibre' => 'Vláknina',
    'weight' => 'Hmotnost',
    'expiry' => 'Datum spotřeby',
    'barcode' => 'Čárový kód',
][$icon]}
<span class="food-icon-tooltip" tabindex="0" role="img" aria-label="{$label}" data-tooltip="{$label}">
<svg class="food-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {switch $icon}
        {case 'price'}
            <circle cx="9" cy="9" r="6"/>
            <path d="M15 8a6 6 0 1 1-7 7M9 6v6m-2-1h3a1 1 0 0 0 0-2H8a1 1 0 0 1 0-2h3"/>
        {case 'calories'}
            <path d="M12 3c1 5-4 6-4 10a4 4 0 0 0 8 0c0-1-1-3-2-4 4 2 6 5 5 8a7 7 0 0 1-14-1c0-5 5-7 7-13Z"/>
        {case 'protein'}
            <path d="M12.4 13a5 5 0 0 0-6.4.1"/>
            <path d="M16.6 10a5 5 0 0 1-4.2 3L11 7l2-3c.5-1.1.2-2.1-1-2H9.8c-.5 0-.9.2-1.2.6L6.5 6.5c-.2.3-.4.6-.5 1L2.7 17c-.2.6-.1 1.3.3 1.8C4.1 20.2 6.1 22 12 22s11-4 11-9a5 5 0 0 0-6.4-3Z"/>
        {case 'fat'}
            <path d="M12 3S5 11 5 15a7 7 0 0 0 14 0c0-4-7-12-7-12Z"/>
            <path d="M9 15a3 3 0 0 0 3 3"/>
        {case 'carb'}
            <path d="m5 21 13-13M8 18c-4 0-5-3-5-5 3 0 6 1 5 5Zm4-4c-4 0-5-3-5-5 3 0 6 1 5 5Zm0 0c0 4 3 5 5 5 0-3-1-6-5-5Zm4-4c0 4 3 5 5 5 0-3-1-6-5-5Zm0 0c-1-4 1-6 5-7 0 4-1 6-5 7Z"/>
        {case 'fibre'}
            <path d="M20 4C9 2 3 7 5 14c2 7 15 5 15-10Z"/>
            <path d="M4 21 16 9m-6 6v-4m0 4h4"/>
        {case 'weight'}
            <circle cx="12" cy="5" r="3"/>
            <path d="M7 8h10l4 13H3L7 8Z"/>
        {case 'expiry'}
            <rect x="3" y="5" width="18" height="16" rx="2"/>
            <path d="M7 3v4m10-4v4M3 11h18m-13 5h3"/>
        {case 'barcode'}
            <path d="M3 5v14M6 5v14M10 5v14M12 5v14M16 5v14M19 5v14M21 5v14"/>
    {/switch}
</svg>
</span>
