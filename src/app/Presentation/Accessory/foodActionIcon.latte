{varType string $action}
<svg class="food-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {switch $action}
        {case 'consume'}
            <path d="M3 3v5a3 3 0 0 0 6 0V3M6 3v18M3 7h6M20 3v18M20 3c-4 2-5 6-5 10h5"/>
        {case 'trash'}
            <path d="M3 6h18M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M5 6l1 14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1l1-14M10 10v7m4-7v7"/>
    {/switch}
</svg>