{varType App\Model\Entity\HouseholdEntity|null $household}
{varType App\Model\Entity\HouseholdEntity|null $request}
{varType App\Model\Entity\ApplianceEntity[] $appliances}
{varType bool $isModerator}

{block title}Přehled{/block}

{block content}
<header class="page-header">
	<div>
		<small>Domácnost / Přehled</small>
		<h1>Přehled domácnosti</h1>
		<p>{if $household}{$household->getName()}{elseif $request}Čekáte na přijetí do domácnosti {$request->getName()}.{else}Založte si domácnost nebo požádejte o připojení.{/if}</p>
	</div>
	{if $household && $isModerator}
		<div class="actions">
            <a class="button button-primary" n:href="Appliance:create">Přidat spotřebič</a>
			<a class="button button-outline" n:href="Household:settings">Nastavení domácnosti</a>
		</div>
	{elseif $request}
		<div class="actions">
			<span class="badge">Žadatel</span>
			{form cancelRequestForm}{input send, class: 'button button-outline'}{/form}
		</div>
	{/if}
</header>

{if $household}
<section class="card-grid" aria-labelledby="appliances-title">
    {if $appliances != null}
        <h2 id="appliances-title">Spotřebiče v domácnosti</h2>
    {/if}
    {foreach $appliances as $appliance}
        <article class="card appliance-card">
            <div class="appliance-card-heading">
                <h3><a n:href="Appliance:detail, id: $appliance->getId()">{$appliance->getName()}</a></h3>
                {include '../Accessory/applianceIcon.latte', name: $appliance->getName()}
            </div>
            {if $isModerator}
                <div class="actions">
                    <a class="button button-outline" n:href="Appliance:edit, id: $appliance->getId()">Upravit</a>
                    <a class="button button-danger" n:href="Appliance:delete, id: $appliance->getId()">Smazat</a>
                </div>
            {/if}
        </article>
    {else}
        <div class="empty-state">
            <h3>Zatím tu nejsou žádné spotřebiče</h3>
            {if $isModerator}
                <p>Přidejte první spotřebič do své domácnosti.</p>
                <div class="actions">
                    <a class="button button-primary" n:href="Appliance:create">Přidat spotřebič</a>
                </div>
            {else}
                <p>Spotřebiče může přidat správce domácnosti.</p>
            {/if}
        </div>
    {/foreach}
</section>
{else}
<section class="empty-state" aria-labelledby="welcome-title">
    {if $request}
        <h2 id="welcome-title">Žádost čeká na schválení</h2>
        <p>Správce domácnosti {$request->getName()} vaši žádost zatím neposoudil.</p>
    {else}
        <h2 id="welcome-title">Vítejte ve Spíži</h2>
        <p>Pro začátek vytvořte domácnost nebo zadejte pozvánkový token od jejího správce.</p>
        <div class="actions">
            <a class="button button-primary" n:href="Household:create">Vytvořit domácnost</a>
            <a class="button button-outline" n:href="Household:request">Požádat o připojení</a>
        </div>
    {/if}
</section>
{/if}
{/block}
