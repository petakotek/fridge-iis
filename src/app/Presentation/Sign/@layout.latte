<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>{ifset title}{include title|stripHtml} · {/ifset}Spíž</title>

	<link rel="stylesheet" href="{= $basePath . '/www/css/app.css'}">
	{asset? 'main.js'}
</head>

<body>
	<main class="auth-page" id="main-content">
		<a class="auth-brand" n:href="Sign:in" aria-label="Spíž – přihlášení">Spíž</a>
		{foreach $flashes as $flash}
			<div n:class="notice, $flash->type" role="status">{$flash->message}</div>
		{/foreach}
		{include content}
	</main>
</body>
</html>
