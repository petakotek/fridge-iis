{varType App\Model\Entity\HouseholdEntity $household}
{varType App\Model\Entity\UserEntity[] $requests}
{varType App\Model\Entity\UserEntity[] $members}

{block title}Správa domácnosti{/block}

{block content}
<header class="page-header">
	<div>
		<small>Domácnost / Správa</small>
		<h1>Správa domácnosti</h1>
		<p>Spravujte údaje domácnosti, členství a pozvánkový token.</p>
	</div>
	<div class="actions"><a class="button button-outline" n:href="Home:default">Zpět na přehled</a></div>
</header>
<div class="stack">
	<section class="card">
		<h2>Údaje domácnosti</h2>
		{form settingsForm}
			<div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
			<div class="field">{label name /}{input name}</div>
			{input send, class: 'button button-primary'}
		{/form}
	</section>
	<section class="card">
		<h2>Pozvánkový token</h2>
		<p>Tento token předejte lidem, kteří chtějí požádat o členství ve vaší domácnosti. Pozvánkový odkaz jim token předvyplní. Vygenerováním nového tokenu přestane původní token fungovat. Stávajících členů a žádostí se změna nedotkne.</p>
		<div class="actions invite-actions">
			<code>{$household->getToken()}</code>
			<button type="button" class="button button-outline" data-copy-text="{$household->getToken()}">Kopírovat token</button>
			<button type="button" class="button button-outline" data-copy-url="{link Household:request, token: $household->getToken()}">Kopírovat odkaz</button>
			{form regenerateTokenForm}
				{input send, class: 'button button-outline'}
			{/form}
		</div>
		<p class="copy-status" role="status" aria-live="polite"></p>
	</section>
	<section class="card" id="requests" n:if="count($requests) > 0">
		<h2>Žádosti o členství</h2>
		<p>Vyberte žádost a rozhodněte, zda ji přijmete.</p>
		{form decisionForm}
			<div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
			<div class="field">{label requesterId /}{input requesterId}</div>
			<div class="actions">{input accept, class: 'button button-primary'}{input reject, class: 'button button-outline'}</div>
		{/form}
	</section>
	<section class="card">
		<h2>Předat správu domácnosti</h2>
		<p>Vybraný člen se stane správcem. Vy zůstanete členem domácnosti a přijdete o přístup k její správě.</p>
		{if count($members) > 1}
			{form transferModeratorForm}
				<div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
				<div class="field">{label memberId /}{input memberId}</div>
				{input send, class: 'button button-outline'}
			{/form}
		{else}
			<p>Správu můžete předat, až bude v domácnosti další člen.</p>
		{/if}
	</section>
	<section class="card">
		<h2>Smazat domácnost</h2>
		<p>Smazáním domácnosti se odstraní její spotřebiče, police, potraviny a kategorie. Členové si ponechají účty, ale přijdou o členství. Čekající žádosti se zruší.</p>
		{form deleteHouseholdForm, onsubmit: "return confirm('Smazání domácnosti je nevratné. Opravdu ji chcete smazat?')"}
			<div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
			<div class="field">{label confirmation /}{input confirmation}</div>
			{input send, class: 'button button-danger'}
		{/form}
	</section>
</div>
<script src="{= $basePath . '/www/js/clipboard.js'}" defer></script>
{/block}
