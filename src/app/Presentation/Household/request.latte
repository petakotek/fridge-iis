{block title}Připojit se k domácnosti{/block}

{block content}
<section class="form-page">
	<header class="page-header">
		<div>
			<small>Domácnost / Žádost</small>
			<h1>Připojit se k domácnosti</h1>
			<p>Zadejte token, který vám dal správce domácnosti.</p>
		</div>
	</header>
	{form requestForm}
		<div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
		<div class="field">{label token /}{input token}<small>Po odeslání vyčkejte než žádost schválí správce domáctnosti.</small></div>
		<div class="actions">{input send, class: 'button button-primary'}<a class="button button-outline" n:href="Home:default">Zpět</a></div>
	{/form}
</section>
{/block}
