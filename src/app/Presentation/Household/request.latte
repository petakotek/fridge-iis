{varType ?App\Model\Entity\HouseholdEntity $invitedHousehold}

{block title}Připojit se k domácnosti{/block}

{block content}
<section class="form-page">
	<header class="page-header">
		<div>
			<small>Domácnost / Žádost</small>
			{if $invitedHousehold}
				<h1>Připojit se k domácnosti {$invitedHousehold->getName()}</h1>
				<p>Byli jste pozváni do domácnosti. Po odeslání žádosti ji musí schválit správce domácnosti.</p>
			{else}
				<h1>Připojit se k domácnosti</h1>
				<p>Zadejte token, který vám dal správce domácnosti.</p>
			{/if}
		</div>
	</header>
	{form requestForm}
		<div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
		{if $invitedHousehold}
			<input n:name="token" type="hidden">
		{else}
			<div class="field">{label token /}{input token}<small>Po odeslání vyčkejte, než žádost schválí správce domácnosti.</small></div>
		{/if}
		<div class="actions">{input send, class: 'button button-primary'}<a class="button button-outline" n:href="Home:default">Zpět</a></div>
	{/form}
</section>
{/block}
