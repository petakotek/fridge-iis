{varType App\Model\Entity\UserEntity $currentUser}
{varType string $accountRole}

<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>{ifset title}{include title|stripHtml} · {/ifset}Spíž</title>

	<link rel="stylesheet" href="{= $basePath . '/www/css/app.css'}">
	{asset? 'main.js'}
</head>

<body>
	{* Další odkazy v postranním panelu stačí přidat do tohoto seznamu. *}
	{var $navigation = [
		['label' => 'Přehled', 'destination' => 'Home:default'],
	]}

	<div class="app-shell">
		<header class="topbar">
			<a class="brand" n:href="Home:default" aria-label="Spíž – úvodní stránka">
				<span class="brand-mark" aria-hidden="true">
					<svg viewBox="0 0 32 32" fill="none"><path d="M6 13h20v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V13Z" stroke="currentColor" stroke-width="2"/><path d="M4 13h24M10 13V8a3 3 0 0 1 6 0v5m2 0V9a3 3 0 0 1 6 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 20h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
				</span>
				<span class="brand-name">Spíž<span class="brand-dot">.</span></span>
			</a>
			<span class="topbar-context">{ifset title}{include title|stripHtml}{/ifset}</span>
			{ifset $currentUser}
				<details class="dropdown">
					<summary>
						<span class="avatar" aria-hidden="true">{mb_substr($currentUser->getName(), 0, 1)|upper}</span>
						<strong>{$currentUser->getName()} {$currentUser->getSurname()}</strong>
					</summary>
					<div class="dropdown-panel">
						<header>
							<strong>{$currentUser->getName()} {$currentUser->getSurname()}</strong>
							<small>{$currentUser->getEmail()}</small>
							<span class="badge">{$accountRole}</span>
						</header>
						<a n:href="Account:default">Upravit profil</a>
						{form logoutForm}
							{input send}
						{/form}
					</div>
				</details>
			{/ifset}
		</header>

		<aside class="sidebar" aria-label="Postranní panel">
			<nav aria-label="Hlavní navigace">
				{foreach $navigation as $item}
					<a href="{link $item['destination']}" {if $presenter->isLinkCurrent($item['destination'])}aria-current="page"{/if}>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
						<span>{$item['label']}</span>
					</a>
				{/foreach}
			</nav>
		</aside>

		<main class="main-content" id="main-content">
			<div class="page-surface">
				{foreach $flashes as $flash}
					<div n:class="notice, $flash->type" role="status">{$flash->message}</div>
				{/foreach}
				{include content}
			</div>
		</main>
	</div>
</body>
</html>
