{varType App\Model\Entity\UserEntity $editedUser}

{block title}Upravit uživatele{/block}
{block content}
<header class="page-header">
    <div>
        {include 'breadcrumbs.latte', section: 'Uživatelé', destination: 'Admin:default', items: [
            ['label' => $editedUser->getName() . ' ' . $editedUser->getSurname(), 'destination' => 'Admin:editUser', 'id' => $editedUser->getId()],
        ]}
        <h1>Upravit uživatele</h1><p>{$editedUser->getName()} {$editedUser->getSurname()}</p>
    </div>
    <a class="button button-outline" n:href="default">Zpět na uživatele</a>
</header>
<div class="stack">
    <section class="card">{form userForm}{include 'userFields.latte', form: $form}{/form}</section>
    <section class="card" n:if="!$editedUser->isAdmin()">
        <h2>Domácnost a členství</h2>
        <p n:if="$editedUser->getHouseholdRequest()">Čekající žádost: {$editedUser->getHouseholdRequest()->getName()}. Přidání do domácnosti tuto žádost zruší.</p>
        {if $editedUser->getHousehold()}
            <p>Domácnost: {$editedUser->getHousehold()->getName()}</p>
            <a class="button button-outline" n:href="editHousehold, id: $editedUser->getHousehold()->getId()">Spravovat členství</a>
        {else}
            <p>Uživatel není členem domácnosti. Vytvořte mu domácnost nebo jej přidejte do některé ze stávajících.</p>
            <div class="actions"><a class="button button-primary" n:href="createHousehold">Vytvořit domácnost</a><a class="button button-outline" n:href="households">Vybrat domácnost</a></div>
        {/if}
    </section>
</div>
{/block}
