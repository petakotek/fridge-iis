{varType App\Model\Entity\UserEntity[] $accounts}

{block title}Správa uživatelů{/block}
{block content}
<header class="page-header">
    <div>
        {include 'breadcrumbs.latte', section: 'Uživatelé', destination: 'Admin:default'}
        <h1>Správa uživatelů</h1><p>Účty, přihlašovací údaje a systémové role všech uživatelů.</p>
    </div>
    <div class="actions"><a class="button button-primary" n:href="Admin:createUser">Přidat uživatele</a><a class="button button-outline" n:href="Admin:households">Správa domácností</a></div>
</header>
<section class="stack">
    <div class="table-scroll">
        <table class="food-table">
            <caption class="visually-hidden">Uživatelé systému</caption>
            <thead><tr><th scope="col">Jméno</th><th scope="col">E-mail</th><th scope="col">Role</th><th scope="col">Domácnost</th><th scope="col">Akce</th></tr></thead>
            <tbody>
                <tr n:foreach="$accounts as $account">
                    <td>{$account->getName()} {$account->getSurname()}</td>
                    <td>{$account->getEmail()}</td>
                    <td>{if $account->isAdmin()}Administrátor{elseif $account->getHousehold()?->getModerator() === $account}Správce domácnosti{else}Registrovaný uživatel{/if}</td>
                    <td>{if $account->getHousehold()}<a n:href="Admin:editHousehold, id: $account->getHousehold()->getId()">{$account->getHousehold()->getName()}</a>{else}Bez domácnosti{/if}</td>
                    <td><div class="actions"><a class="button button-outline" n:href="Admin:editUser, id: $account->getId()">Upravit</a><a class="button button-danger" n:href="Admin:deleteUser, id: $account->getId()" n:if="$account !== $currentUser">Smazat</a></div></td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
{/block}
