{block title}Přidat uživatele{/block}
{block content}
<header class="page-header">
    <div>
        {include 'breadcrumbs.latte', section: 'Uživatelé', destination: 'Admin:default', items: [
            ['label' => 'Přidat uživatele', 'destination' => 'Admin:createUser'],
        ]}
        <h1>Přidat uživatele</h1><p>Nový účet má výchozí roli registrovaného uživatele.</p>
    </div>
    <a class="button button-outline" n:href="default">Zpět na uživatele</a>
</header>
<div class="stack"><section class="card">{form userForm}{include 'userFields.latte', form: $form}{/form}</section></div>
{/block}
