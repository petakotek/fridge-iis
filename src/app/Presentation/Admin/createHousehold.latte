{block title}Přidat domácnost{/block}
{block content}
<header class="page-header">
    <div>
        {include 'breadcrumbs.latte', section: 'Domácnosti', destination: 'Admin:households', items: [
            ['label' => 'Přidat domácnost', 'destination' => 'Admin:createHousehold'],
        ]}
        <h1>Přidat domácnost</h1><p>Správce můžete vybrat nyní nebo později z členů domácnosti. Sami se členem nestanete.</p>
    </div>
    <a class="button button-outline" n:href="Admin:households">Zpět na domácnosti</a>
</header>
<div class="stack"><section class="card">
    {form householdForm}
        <div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
        <div class="field">{label name /}{input name}</div>
        <div class="field">{label moderatorId /}{input moderatorId}<small>Nepovinné. Výběr uživatele zruší jeho případnou žádost o členství.</small></div>
        {input send, class: 'button button-primary'}
    {/form}
</section></div>
{/block}
