{block title}Přidat kategorii{/block}

{block content}
<section class="form-page">
    <header class="page-header">
        <div>
            <small>Kategorie / Nová</small>
            <h1>Přidat kategorii</h1>
            <p>Zadejte název a případně vyberte nadřazenou kategorii.</p>
        </div>
    </header>
    {form createForm}
        <div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
        <div class="field">{label name /}{input name}</div>
        <div class="field">{label parent /}{input parent}</div>
        <div class="actions">{input send, class: 'button button-primary'}<a class="button button-outline" n:href="default">Zpět</a></div>
    {/form}
</section>
{/block}
