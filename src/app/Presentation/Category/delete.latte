{varType App\Model\Entity\CategoryEntity $category}
{block title}Smazat kategorii{/block}

{block content}
<section class="form-page">
    <header class="page-header">
        <div>
            <small>Kategorie / Smazání</small>
            <h1>Smazat kategorii</h1>
            <p>Opravdu chcete smazat kategorii „{$category->getName()}“?</p>
        </div>
    </header>
    <p>Kategorii lze smazat pouze tehdy, pokud neobsahuje podkategorie a není přiřazena k potravinám.</p>
    {form deleteForm}
        <div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
        <div class="actions">{input send, class: 'button button-danger'}<a class="button button-outline" n:href="default">Zrušit</a></div>
    {/form}
</section>
{/block}
