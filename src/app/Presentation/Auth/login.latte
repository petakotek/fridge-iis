{block title}Přihlášení{/block}

{block content}
<h1>Přihlášení</h1>
{form loginForm}
	<p n:foreach="$form->getErrors() as $error" role="alert">{$error}</p>
	<p>{label email /}<br>{input email}</p>
	<p>{label password /}<br>{input password}</p>
	<p>{input send}</p>
{/form}
<p><a n:href="Auth:register">Registrace</a></p>
{/block}
