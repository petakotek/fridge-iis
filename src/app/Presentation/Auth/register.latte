{block title}Registrace{/block}

{block content}
<h1>Registrace</h1>
{form registerForm}
	<p n:foreach="$form->getErrors() as $error" role="alert">{$error}</p>
	<p>{label name /}<br>{input name}</p>
	<p>{label surname /}<br>{input surname}</p>
	<p>{label email /}<br>{input email}</p>
	<p>{label password /}<br>{input password}</p>
	<p>{input send}</p>
{/form}
<p><a n:href="Auth:login">Přihlášení</a></p>
{/block}
