{varType App\Model\Entity\ApplianceEntity $appliance}
{varType App\Model\Entity\ShelfEntity $shelf}
{varType bool $fromDetail}
{varType int $returnPage}
{block title}Upravit polici{/block}

{block content}
<section class="form-page">
    <header class="page-header">
        <div>
            <small>Spotřebič / Police</small>
            <h1>Upravit polici</h1>
            <p>{$appliance->getName()}</p>
        </div>
    </header>
    {form editForm}
        <div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
        <div class="field">{label name /}{input name}</div>
        <div class="field">{label capacity /}{input capacity}</div>
        <div class="actions">{input send, class: 'button button-primary'}{if $fromDetail}<a class="button button-outline" n:href="detail, id: $shelf->getId(), page: $returnPage">Zpět na polici</a>{else}<a class="button button-outline" n:href="Appliance:detail, id: $appliance->getId()">Zpět na spotřebič</a>{/if}</div>
    {/form}
</section>
{/block}
