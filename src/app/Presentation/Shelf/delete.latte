{varType App\Model\Entity\ApplianceEntity $appliance}
{varType App\Model\Entity\ShelfEntity $shelf}
{varType bool $fromDetail}
{varType int $returnPage}
{block title}Smazat polici{/block}

{block content}
<section class="form-page">
    <header class="page-header">
        <div>
            <small>Spotřebič / Police</small>
            <h1>Smazat polici</h1>
            <p>{$appliance->getName()}</p>
        </div>
    </header>
    {form deleteForm}
        <div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
        <p class="notice error">Opravdu chcete smazat polici „{$shelf->getName()}“? Smazání je nevratné a odstraní také potraviny na této polici.</p>
        <div class="actions">{input send, class: 'button button-danger'}{if $fromDetail}<a class="button button-outline" n:href="Shelf:detail, id: $shelf->getId(), page: $returnPage">Zpět na polici</a>{else}<a class="button button-outline" n:href="Appliance:detail, id: $appliance->getId()">Zpět na spotřebič</a>{/if}</div>
    {/form}
</section>
{/block}
