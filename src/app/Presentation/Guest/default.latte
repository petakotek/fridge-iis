{varType App\Model\Entity\HouseholdEntity $household}
{varType array $appliances}
{varType array $pages}

{block title}{$household->getName()}{/block}

{block content}
<header class="page-header">
	<div>
		<small>Host / Jen pro čtení</small>
		<h1>{$household->getName()}</h1>
		<p>Prohlížíte obsah domácnosti jako host. </p>
	</div>
	<div class="actions">
		<span class="badge">Host</span>
		{form leaveForm}{input send, class: 'button button-outline'}{/form}
	</div>
</header>

<div class="stack">
	{foreach $appliances as $item}
		<section class="card">
			<h2>{$item['appliance']->getName()}</h2>
			{foreach $item['shelves'] as $row}
				<h3>{$row['shelf']->getName()} <small>Potravin {$row['paginator']->getItemCount()} · Kapacita {$row['shelf']->getShelfCapacity()} g</small></h3>
				<table class="food-table" n:if="$row['foods']">
					<thead><tr><th>Potravina</th><th>Kategorie</th><th>Spotřebovat do</th><th>Hmotnost</th></tr></thead>
					<tbody>
						<tr n:foreach="$row['foods'] as $food">
							<td>{$food->getName()}</td>
							<td>{include '../Accessory/foodCategories.latte', food: $food}</td>
							<td>{$food->getExpiry()|date:'j. n. Y'}</td>
							<td>{if $food->getWeight() !== null}{$food->getWeight()} g{/if}</td>
						</tr>
					</tbody>
				</table>
				<small n:if="!$row['foods']">Polička je prázdná.</small>
				{if $row['paginator']->getPageCount() > 1}
					<nav class="pagination" aria-label="Stránkování potravin: {$row['shelf']->getName()}">
						{for $pageNumber = 1; $pageNumber <= $row['paginator']->getPageCount(); $pageNumber++}
							<a class="pagination-page"
								n:href="default, pages: array_replace($pages, [$row['shelf']->getId() => $pageNumber])"
								aria-label="Stránka {$pageNumber}"
								n:attr="aria-current: $row['paginator']->getPage() === $pageNumber ? 'page' : null">{$pageNumber}</a>
						{/for}
					</nav>
				{/if}
			{else}
				<small>Spotřebič nemá žádné poličky.</small>
			{/foreach}
		</section>
	{else}
		<section class="empty-state">
			<h2>Zatím tu nic není</h2>
			<p>Tato domácnost zatím nemá žádné spotřebiče.</p>
		</section>
	{/foreach}
</div>
{/block}
