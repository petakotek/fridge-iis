{varType App\Model\Entity\FoodEntity[] $foods}
{varType App\Model\Entity\ShelfEntity|null $selectedShelf}
{varType bool $hasShelves}
{varType string $status}
{varType Nette\Utils\Paginator $paginator}
{varType array $foodNavigation}
{block title}Potraviny{/block}

{block content}
<header class="page-header">
    <div>
        <small><a n:href="Home:default">Domácnost</a> / <a n:href="Food:default, returnTo: []">Potraviny</a></small>
        <h1>Potraviny</h1>
        <p n:if="$selectedShelf">Police: <a n:href="Shelf:detail, id: $selectedShelf->getId()">{$selectedShelf->getName()}</a></p>
        <p>
            {if $status === 'consumed'}
                Potraviny, které jste spotřebovali.
            {elseif $status === 'trashed'}
                Vyhozené potraviny z vaší domácnosti.
            {else}
                Přehled uložených potravin v domácnosti.
            {/if}
        </p>
    </div>
    <div class="actions">
        <a class="button button-primary" n:if="$hasShelves" n:href="Food:add, shelfId: $selectedShelf?->getId(), returnTo: $foodNavigation">Přidat potravinu</a>
        <a class="button button-outline" n:if="$selectedShelf" n:href="Food:default, shelfId: null, status: $status, page: 1">Všechny police</a>
    </div>
</header>
<nav class="actions" aria-label="Stav potravin">
    {foreach ['active' => 'Uložené', 'consumed' => 'Moje spotřebované', 'trashed' => 'Vyhozené v domácnosti'] as $value => $label}
        <a class="button {if $status === $value}button-primary{else}button-outline{/if}"
            n:href="Food:default, shelfId: $selectedShelf?->getId(), status: $value, page: 1"
            n:attr="aria-current: $status === $value ? 'page' : null">{$label}</a>
    {/foreach}
</nav>
<section class="card-grid" aria-label="Potraviny">
    {foreach $foods as $food}

        <article class="card">

            <h3>
                <a n:href="Food:detail, id: $food->getId(), returnTo: $foodNavigation">{$food->getName()}</a>
            </h3>
            <p><a n:href="Appliance:detail, id: $food->getShelf()->getAppliance()->getId()">{$food->getShelf()->getAppliance()->getName()}</a> / <a n:href="Shelf:detail, id: $food->getShelf()->getId()">{$food->getShelf()->getName()}</a></p>
            <p>Kategorie: {include '../Accessory/foodCategories.latte', food: $food}</p>
            <p><span class="food-value">{include '../Accessory/foodIcon.latte', icon: 'expiry'}<span>{if $food->getExpiry()}{$food->getExpiry()|date:'j. n. Y'}{else}Neuvedeno{/if}</span>{include '../Accessory/foodExpiry.latte', food: $food}</span></p>
            {if $food->isConsumed()}
                <p>Spotřebováno: {$food->getConsumedAt()|date:'j. n. Y H:i'}</p>
            {elseif $food->isTrashed()}
                <p>Vyhozeno: {$food->getDiscardedAt()|date:'j. n. Y H:i'}</p>
            {/if}
            <div n:class="actions, ($food->isConsumed() || $food->isTrashed()) ? food-restore-actions">
                {if !$food->isConsumed() && !$food->isTrashed()}
                    <a class="button button-outline" n:href="Food:edit, id: $food->getId(), returnTo: $foodNavigation">Upravit</a>
                <span class="food-icon-tooltip" tabindex="0" role="img" aria-label="Spotřebovat" data-tooltip="Spotřebovat">
                    <a class="button button-primary" n:href="Food:consume, id: $food->getId(), returnTo: $foodNavigation" >{include '../Accessory/foodActionIcon.latte', action: 'consume'}</a>
                </span>
                <span class="food-icon-tooltip" tabindex="0" role="img" aria-label="Vyhodit" data-tooltip="Vyhodit">
                    <a class="button button-danger" n:href="Food:trash, id: $food->getId(), returnTo: $foodNavigation">{include '../Accessory/foodActionIcon.latte', action: 'trash'}</a>
                </span>
                {else}
                    <a class="button button-primary" n:href="Food:restore, id: $food->getId(), returnTo: $foodNavigation">Vrátit do zásob</a>
                    <a class="button button-outline" n:href="Food:detail, id: $food->getId(), returnTo: $foodNavigation">Zobrazit detail</a>
                {/if}
            </div>

        </article>

    {else}
        <div class="empty-state">
            {if $status === 'consumed'}
                <h3>Zatím jste nespotřebovali žádné potraviny</h3>
            {elseif $status === 'trashed'}
                <h3>Zatím tu nejsou žádné vyhozené potraviny</h3>
            {else}
                <h3>Zatím tu nejsou žádné potraviny</h3>
                <p>{if $hasShelves}Přidejte potravinu pomocí tlačítka výše.{else}Pro přidání potravin musí správce domácnosti nejprve vytvořit spotřebič a polici.{/if}</p>
            {/if}
        </div>
    {/foreach}
</section>
{if $paginator->getPageCount() > 1}
    <nav class="pagination" aria-label="Stránkování potravin">
        {for $pageNumber = 1; $pageNumber <= $paginator->getPageCount(); $pageNumber++}
            <a class="pagination-page"
                n:href="Food:default, page: $pageNumber, shelfId: $selectedShelf?->getId(), status: $status"
                aria-label="Stránka {$pageNumber}"
                n:attr="aria-current: $paginator->getPage() === $pageNumber ? 'page' : null">{$pageNumber}</a>
        {/for}
    </nav>
{/if}
{/block}
