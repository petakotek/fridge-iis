{varType App\Model\Entity\FoodEntity $food}
{varType array $foodNavigation}
{varType array $detailNavigation}
{block title}{$food->getName()}{/block}

{block content}
<header class="page-header">
    <div>
        {include 'breadcrumbs.latte', label: $food->getName()}
        <h1>{$food->getName()}</h1>
        <p>Uloženo na polici <a style="color: #348250FF;" n:href="Shelf:detail, id: $food->getShelf()->getId()">{$food->getShelf()->getName()}</a></p>
    </div>
    <div class="actions">
        {if !$food->isConsumed() && !$food->isTrashed() }
            <a class="button button-outline" n:href="edit, id: $food->getId(), returnTo: $detailNavigation">Upravit</a>
        {/if}

        <a class="button button-danger" n:href="delete, id: $food->getId(), returnTo: $detailNavigation">Smazat trvale</a>
        <a class="button button-outline" href="{$presenter->link($backDestination, $backParameters)}">{$backLabel}</a>
    </div>
</header>
<p>Kategorie: {include '../Accessory/foodCategories.latte', food: $food}</p>
<article class="actions">
    {if !$food->isConsumed() && !$food->isTrashed()}
        <a class="button button-primary" n:href="consume, id: $food->getId(), returnTo: $detailNavigation">Spotřebovat</a>
        <a class="button button-outline-danger" n:href="trash, id: $food->getId(), returnTo: $detailNavigation">Vyhodit</a>
    {else}
        <a class="button button-primary" n:href="restore, id: $food->getId(), returnTo: $detailNavigation">Vrátit do zásob</a>
    {/if}
</article>
<p class="muted">Energie a živiny jsou uvedené za celé balení.</p>
<article class="card card-grid">
    <p>
        <span class="food-value">
            {include '../Accessory/foodIcon.latte', icon: 'expiry'}
            <span>
                {if $food->getExpiry()}
                    {$food->getExpiry()|date:'j. n. Y'}
                {else}
                    Neuvedeno
                {/if}
            </span>
            {include '../Accessory/foodExpiry.latte', food: $food}
        </span>
    </p>
    <p>
        <span class="food-value">
            {include '../Accessory/foodIcon.latte', icon: 'weight'}
            <span>
                {$food->getWeight()} g
            </span>
        </span>
    </p>
    <p>
        <span class="food-value">
            {include '../Accessory/foodIcon.latte', icon: 'price'}
            <span>
                {$food->getPrice()|number:2, ',', ' '} Kč
            </span>
        </span>
    </p>
    <p>
        <span class="food-value">
            {include '../Accessory/foodIcon.latte', icon: 'calories'}
            <span>
                {$food->getCalories()} kcal
            </span>
        </span>
    </p>
    <p>
        <span class="food-value">
            {include '../Accessory/foodIcon.latte', icon: 'protein'}
            <span>
                {$food->getProtein()} g
            </span>
        </span>
    </p>
    <p>
        <span class="food-value">
            {include '../Accessory/foodIcon.latte', icon: 'fat'}
            <span>
                {$food->getFat()} g
            </span>
        </span>
    </p>
    <p>
        <span class="food-value">{include '../Accessory/foodIcon.latte', icon: 'carb'}
            <span>
                {$food->getCarb()} g
            </span>
        </span>
    </p>
    <p>
        <span class="food-value">
            {include '../Accessory/foodIcon.latte', icon: 'fibre'}
            <span>
                {$food->getFibre()} g
            </span>
        </span>
    </p>
    <div class="food-barcode-value">
        <p>
            <span class="food-value">
                <span>
                    {include '../Accessory/foodBarcode.latte', barcode: $food->getBarcode()}
                </span>
            </span>
        </p>
    </div>
</article>
{/block}
