{varType bool $hasShelves}
{block title}Přidat potravinu{/block}

{block content}
<section class="form-page">
    <header class="page-header">
        <div><small>Domácnost / Potraviny</small><h1>Přidat potravinu</h1></div>
    </header>
    {if $hasShelves}
        {form addForm}
            <div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
            <div class="field">{label name /}{input name}</div>
            <div class="field">{label shelfId /}{input shelfId}</div>
            <div class="field">{label expiry /}{input expiry}</div>
            <div class="field">{label weight /}{input weight}</div>
            <div class="field">{label barcode /}{input barcode}</div>
            <div class="field">{label price /}{input price}</div>
            <div class="field">{label calories /}{input calories}</div>
            <div class="field">{label protein /}{input protein}</div>
            <div class="field">{label fat /}{input fat}</div>
            <div class="field">{label carb /}{input carb}</div>
            <div class="field">{label fibre /}{input fibre}</div>
            <div class="actions">{input send, class: 'button button-primary'}<a class="button button-outline" n:href="default">Zpět na potraviny</a></div>
        {/form}
    {else}
        <div class="empty-state">
            <p>Pro přidání potravin musí správce domácnosti nejprve vytvořit spotřebič a polici.</p>
            <a class="button button-outline" n:href="Home:default">Zpět na přehled</a>
        </div>
    {/if}
</section>
{/block}
