{varType App\Model\Entity\FoodEntity $food}
{block title}Upravit potravinu{/block}

{block content}
<section class="form-page">
    <header class="page-header">
        <div>{include 'breadcrumbs.latte', label: 'Upravit potravinu'}<h1>Upravit potravinu</h1><p>{$food->getName()}</p></div>
    </header>
    {form editForm}
        <div class="notice error" n:foreach="$form->getErrors() as $error">{$error}</div>
        <div class="field">{label name /}{input name}</div>
        <div class="field">{label expiry /}{input expiry}</div>
        {include 'categoryFields.latte', form: $form}
        <div class="actions">{input send, class: 'button button-primary'}<a class="button button-outline" href="{$presenter->link($cancelDestination, $cancelParameters)}">{$cancelLabel}</a></div>
    {/form}
</section>
{/block}
