digraph Prehled {
    graph [charset="UTF-8", rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=1.1,
        fontname="DejaVu Sans", fontsize=20, labelloc=t,
        label="Lednice — přehled případů užití a hierarchie rolí"];
    node [shape=ellipse, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#eef5ff", color="#476582"];
    edge [fontname="DejaVu Sans", fontsize=10, color="#526171"];

    host [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Host<BR/>(neregistrovaný uživatel)>];
    user [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Registrovaný uživatel>];
    member [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Člen domácnosti>];
    manager [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Správce domácnosti>];
    admin [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Administrátor>];

    { rank=same; host; user; member; manager; admin; }
    member -> user [arrowhead=empty, label="dědí práva", color="#927335", constraint=false];
    manager -> member [arrowhead=empty, label="dědí práva", color="#927335", constraint=false];

    subgraph cluster_system {
        label="Informační systém pro správu potravin v domácnostech";
        fontsize=14;
        color="#9aabba";
        registration [label="Registrace s tokenem i bez;\nse žádostí o členství\npouze z detailu domácnosti\n(01, 02)"];
        shared [label="Prohlédnout domácnost\npřes platný token\n(07, 08)"];
        session [label="Přihlášení a odhlášení\n(03, 04)"];
        account [label="Úprava vlastního profilu\n(05)"];
        household [label="Vytvořit domácnost\na stát se jejím správcem\n(06)"];
        request [label="Požádat o členství\npomocí platného tokenu\n(09)"];
        membership [label="Rozhodovat o žádostech\na spravovat členy a jejich role\n(10–14)"];
        tokens [label="Sdílet odkaz, kopírovat\na přegenerovat token\n(15–17)"];
        equipment [label="Spravovat spotřebiče,\npoličky a kategorie potravin\n(18–26)"];
        food [label="Prohlížet a přidávat potraviny,\nevidovat konzumaci a vyhození\n(27–31)"];
        consumption [label="Zobrazit vlastní profil spotřeby\na upozornění na trvanlivost\n(32, 33)"];
        users [label="Spravovat uživatelské účty\na systémové role\n(34–37)"];
    }

    host -> { registration shared } [dir=none];
    user -> { shared session account household request } [dir=none];
    member -> { food consumption } [dir=none];
    manager -> { membership tokens equipment } [dir=none];
    admin -> { session users } [dir=none];

    scope [shape=note, fillcolor="#f8f8f8", label="Správce a člen jsou role v konkrétní domácnosti.\nZaložení domácnosti → zakladatel je její správce.\nPřijetí žádosti → žadatel je její člen.\nToken sám o sobě neuděluje členství ani právo editace.\nOválné uzly zde shrnují případy z podrobných diagramů."];
    scope -> household [style=dotted, dir=none, constraint=false];
}
