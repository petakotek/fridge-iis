digraph Administrace {
    graph [charset="UTF-8", rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=1,
        fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Lednice — administrace uživatelů"];
    node [shape=ellipse, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#eef5ff", color="#476582"];
    edge [fontname="DejaVu Sans", fontsize=10, color="#526171"];

    admin [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Administrátor>];

    subgraph cluster_system {
        label="Informační systém — správa účtů";
        fontsize=14;
        color="#9aabba";
        UC03 [label="UC03: Přihlásit se"];
        UC04 [label="UC04: Odhlásit se"];
        UC34 [label="UC34: Přidat uživatelský účet\na nastavit jeho roli"];
        UC35 [label="UC35: Upravit uživatelský účet"];
        UC36 [label="UC36: Deaktivovat\nuživatelský účet"];
        UC37 [label="UC37: Změnit systémovou roli\n(uživatel / administrátor)"];
    }

    admin -> { UC03 UC04 UC34 UC35 UC36 UC37 } [dir=none];

    roles [shape=note, fillcolor="#f8f8f8", label="Administrátor spravuje uživatelské účty a systémové role.\nZ role administrátora neplynou práva správce ani člena\ndomácnosti; není součástí jejich hierarchie.\nDomácí role člen / správce spravuje správce v UC14."];
    roles -> UC34 [style=dotted, dir=none, constraint=false];
    deactivation [shape=note, fillcolor="#f8f8f8", label="Obecné zadání připouští mazání NEBO deaktivaci účtů.\nNávrh používá deaktivaci: účet ztratí přístup,\nhistorie konzumace / vyhození zůstane zachována.\nDomácnost nesmí zůstat bez aktivního správce\na systém bez aktivního administrátora."];
    deactivation -> UC36 [style=dotted, dir=none, constraint=false];
}
