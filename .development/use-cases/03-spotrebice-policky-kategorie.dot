digraph VybaveniAKategorie {
    graph [charset="UTF-8", rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=1,
        fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Lednice — spotřebiče, poličky a kategorie potravin"];
    node [shape=ellipse, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#eef5ff", color="#476582"];
    edge [fontname="DejaVu Sans", fontsize=10, color="#526171"];

    manager [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Správce domácnosti>];

    subgraph cluster_system {
        label="Informační systém — správa vybavení a katalogu domácnosti";
        fontsize=14;
        color="#9aabba";
        subgraph cluster_appliances {
            label="Spotřebiče (lednice, mrazáky)";
            UC18 [label="UC18: Přidat spotřebič\ndo domácnosti"];
            UC19 [label="UC19: Upravit spotřebič"];
            UC20 [label="UC20: Odebrat spotřebič"];
        }
        subgraph cluster_shelves {
            label="Poličky spotřebiče";
            UC21 [label="UC21: Přidat poličku\na určit její maximální nosnost"];
            UC22 [label="UC22: Upravit poličku\nvčetně maximální nosnosti"];
            UC23 [label="UC23: Odebrat poličku"];
            UC29 [label="UC29: Ověřit nosnost poličky"];
        }
        subgraph cluster_categories {
            label="Víceúrovňový katalog kategorií potravin";
            UC24 [label="UC24: Přidat kategorii\n(včetně podkategorie)"];
            UC25 [label="UC25: Upravit kategorii\na její nadřazenou kategorii"];
            UC26 [label="UC26: Odebrat kategorii"];
        }
    }

    manager -> { UC18 UC19 UC20 UC21 UC22 UC23 UC24 UC25 UC26 } [dir=none];
    UC22 -> UC29 [style=dashed, label="«include»"];

    equipment [shape=note, fillcolor="#f8f8f8", label="Domácnost má libovolný počet spotřebičů.\nKaždá polička patří konkrétnímu spotřebiči.\nNosnost musí být kladná; při úpravě nesmí klesnout\npod součet hmotností aktuálně uložených potravin."];
    equipment -> UC22 [style=dotted, dir=none, constraint=false];
    integrity [shape=note, fillcolor="#f8f8f8", label="Odebrání spotřebiče, poličky nebo kategorie nesmí\nzanechat neplatné vazby ani smazat historii spotřeby.\nNávrhové pravidlo: odmítnout smazání používané položky.\nKategorie nesmí být svým vlastním předkem\n(např. Mléčné výrobky → Jogurty → Bílé jogurty)."];
    integrity -> UC26 [style=dotted, dir=none, constraint=false];
}
