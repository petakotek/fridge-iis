digraph ClenstviAToken {
    graph [charset="UTF-8", rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=1,
        fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Lednice — členství a sdílení domácnosti"];
    node [shape=ellipse, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#eef5ff", color="#476582"];
    edge [fontname="DejaVu Sans", fontsize=10, color="#526171"];

    user [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Registrovaný uživatel<BR/>(žadatel)>];
    manager [shape=plain, style="", label=<<FONT FACE="Noto Sans Symbols2" POINT-SIZE="40">&#x1FBC5;</FONT><BR/>Správce domácnosti>];

    subgraph cluster_system {
        label="Informační systém — správa členství a tokenu";
        fontsize=14;
        color="#9aabba";
        UC08 [label="UC08: Ověřit token\na určit příslušnou domácnost"];
        UC09 [label="UC09: Požádat o členství\nv domácnosti pomocí tokenu"];
        UC10 [label="UC10: Přijmout žádost\no členství"];
        UC11 [label="UC11: Zamítnout žádost\no členství"];
        UC12 [label="UC12: Přidat žadatele\nmezi členy domácnosti"];
        UC13 [label="UC13: Odebrat člena\nz domácnosti"];
        UC14 [label="UC14: Změnit roli člena\n(člen / správce domácnosti)"];
        UC15 [label="UC15: Sdílet / poslat odkaz\ns tokenem domácnosti"];
        UC16 [label="UC16: Zkopírovat token\ndomácnosti"];
        UC17 [label="UC17: Přegenerovat token\ndomácnosti"];
    }

    user -> UC09 [dir=none];
    manager -> { UC10 UC11 UC13 UC14 UC15 UC16 UC17 } [dir=none];
    UC09 -> UC08 [style=dashed, label="«include»"];
    UC10 -> UC12 [style=dashed, label="«include»"];

    request [shape=note, fillcolor="#f8f8f8", label="Žádost je svázána se žadatelem a domácností z tokenu.\nSprávce vybírá z čekajících žádostí své domácnosti.\nPřijetí přidělí členství; zamítnutí členství nevytvoří.\nZamítnutý žadatel může dál číst přes platný token.\nJiž existující členství / čekající žádost se neduplikuje."];
    request -> UC10 [style=dotted, dir=none, constraint=false];
    membership [shape=note, fillcolor="#f8f8f8", label="Správa členů se týká vybrané domácnosti.\nOdebrání členství nemaže uživatelský účet.\nZměna domácí role neuděluje systémovou roli administrátora.\nDomácnost musí mít alespoň jednoho správce."];
    membership -> UC14 [style=dotted, dir=none, constraint=false];
    token [shape=note, fillcolor="#f8f8f8", label="Odkaz obsahuje token pro prohlížení dané domácnosti.\nSdílení lze provést předáním odkazu mimo aplikaci.\nKopírování tokenu je samostatná operace.\nPřegenerování vydá nový token a zneplatní starý\ni všechny odkazy s ním; existující členství zůstávají."];
    token -> UC17 [style=dotted, dir=none, constraint=false];
}
